{
  "name": "@alcorexchange/wallet-plugin-evm",
  "version": "0.1.0",
  "description": "Sign Alcor Chain transactions with an Ethereum wallet (MetaMask, Rabby, Coinbase Wallet) in WharfKit Session Kit",
  "license": "BSD-3-Clause",
  "keywords": [
    "wharfkit",
    "wallet-plugin",
    "antelope",
    "alcor",
    "ethereum",
    "metamask",
    "eip-6963"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
